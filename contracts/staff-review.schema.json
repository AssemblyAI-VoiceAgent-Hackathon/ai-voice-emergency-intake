{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://team.example/schemas/staff-review.schema.json",
  "title": "Role 5 Staff Review Submission",
  "description": "Payload sent from Role 5 to Role 3. Reviewer identity and permissions must be derived by Role 3 from the authenticated session, not trusted from this body.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "caseId",
    "baseCaseVersion",
    "idempotencyKey",
    "action",
    "edits"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "caseId": {
      "type": "string",
      "minLength": 1
    },
    "baseCaseVersion": {
      "type": "integer",
      "minimum": 0
    },
    "idempotencyKey": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128
    },
    "action": {
      "type": "string",
      "enum": ["save_draft", "request_more_information", "approve"]
    },
    "edits": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["op", "path", "reason"],
        "properties": {
          "op": {
            "type": "string",
            "enum": ["add", "replace", "remove"]
          },
          "path": {
            "type": "string",
            "pattern": "^/"
          },
          "value": {},
          "reason": {
            "type": ["string", "null"]
          }
        }
      }
    },
    "informationRequest": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["questions"],
      "properties": {
        "questions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "finalTriage": {
      "type": ["object", "null"],
      "description": "Human-entered decision. The allowed code system must be configured and agreed by the clinical team.",
      "additionalProperties": false,
      "required": ["code", "label"],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "rationale": {
          "type": ["string", "null"]
        }
      }
    },
    "comment": {
      "type": ["string", "null"]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "action": {
            "const": "approve"
          }
        },
        "required": ["action"]
      },
      "then": {
        "required": ["finalTriage"],
        "properties": {
          "finalTriage": {
            "type": "object"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "request_more_information"
          }
        },
        "required": ["action"]
      },
      "then": {
        "required": ["informationRequest"],
        "properties": {
          "informationRequest": {
            "type": "object"
          }
        }
      }
    }
  ]
}
