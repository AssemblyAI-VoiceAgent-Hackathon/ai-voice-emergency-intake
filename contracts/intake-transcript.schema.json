{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://team.example/schemas/intake-transcript.schema.json",
  "title": "Role 1 to Role 2 Synthetic Intake Transcript",
  "description": "Schema for transcript turns and other source records supplied to AI extraction. Development examples must contain synthetic data only.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "caseId",
    "sessionId",
    "caseVersion",
    "capturedAt",
    "language",
    "turns",
    "observations",
    "verifiedRecords"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "caseId": {
      "type": "string",
      "minLength": 1
    },
    "sessionId": {
      "type": "string",
      "minLength": 1
    },
    "caseVersion": {
      "type": "integer",
      "minimum": 0
    },
    "capturedAt": {
      "type": "string",
      "format": "date-time"
    },
    "language": {
      "type": ["string", "null"]
    },
    "turns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/turn"
      }
    },
    "observations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/sourceRecord"
      }
    },
    "verifiedRecords": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/sourceRecord"
      }
    }
  },
  "$defs": {
    "turn": {
      "type": "object",
      "additionalProperties": false,
      "required": ["turnId", "speaker", "text", "spokenAt", "final"],
      "properties": {
        "turnId": {
          "type": "string",
          "minLength": 1
        },
        "speaker": {
          "type": "string",
          "enum": ["patient", "caregiver", "staff", "agent", "unknown"]
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "spokenAt": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "final": {
          "type": "boolean",
          "description": "False means the speech-to-text segment is provisional and must not be treated as verified evidence."
        }
      }
    },
    "sourceRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceRef", "name", "value", "unit", "recordedAt"],
      "properties": {
        "sourceRef": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "value": {},
        "unit": {
          "type": ["string", "null"]
        },
        "recordedAt": {
          "type": ["string", "null"],
          "format": "date-time"
        }
      }
    }
  }
}
