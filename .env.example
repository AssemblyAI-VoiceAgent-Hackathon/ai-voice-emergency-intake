# Role 4 / Role 3 Python backend. Do not commit real keys.
# Copy to .env locally. Preferred names:

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-only. Never put this in the browser or git. Bypasses RLS.
# Get it from Dashboard → Settings → API Keys (secret key, not publishable).
# SUPABASE_SECRET_KEY=sb_secret_...

# The dashboard Connect dialog copies Next.js names. Python accepts these too:
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Local encryption for approved clinical payloads (synthetic demo defaults exist).
# ARIA_SECRET_KEY=
# ARIA_BLIND_SALT=

# Force SQLite even if Supabase env vars are set (used by unit tests).
# ARIA_BACKEND=sqlite

# Role 3 demo bearer tokens. Override in any shared environment.
# ARIA_SERVICE_TOKEN=service-demo-token
# ARIA_STAFF_TOKEN=staff-demo-token
# ARIA_DISPATCHER_TOKEN=dispatcher-demo-token
# ARIA_BIND_HOST=127.0.0.1
# ARIA_BIND_PORT=8000
