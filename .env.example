# Role 4 / Role 3 Python backend. Do not commit real keys.
# Copy to .env locally. Preferred names:

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-only. Never put this in the browser or git. Bypasses RLS.
# Get it from Dashboard → Settings → API Keys (secret key, not publishable).
# SUPABASE_SECRET_KEY=sb_secret_...

# The dashboard Connect dialog copies Next.js names. Python accepts these too:
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Local encryption for approved clinical payloads (synthetic demo defaults exist).
# ARIA_SECRET_KEY=
# ARIA_BLIND_SALT=

# Force SQLite even if Supabase env vars are set (used by unit tests).
# ARIA_BACKEND=sqlite

# Role 3 demo bearer tokens. Override in any shared environment.
# ARIA_SERVICE_TOKEN=service-demo-token
# ARIA_STAFF_TOKEN=staff-demo-token
# ARIA_DISPATCHER_TOKEN=dispatcher-demo-token
# ARIA_BIND_HOST=127.0.0.1
# ARIA_BIND_PORT=8000

# Role 5 dashboard (Next.js). Demo staff token only — never a Supabase secret.
# NEXT_PUBLIC_ARIA_API_URL=http://127.0.0.1:8000
# NEXT_PUBLIC_ARIA_STAFF_TOKEN=staff-demo-token
# NEXT_PUBLIC_ARIA_VOICE_URL=http://127.0.0.1:8001

# Role 1 voice (AssemblyAI). Leave unset to run Role 1 in demo/handoff mode.
# ASSEMBLYAI_API_KEY=
# AGENT=emergency-voice
# ARIA_VOICE_BIND_HOST=127.0.0.1
# ARIA_VOICE_BIND_PORT=8001
# ARIA_VOICE_DEMO=1
# Public Role 3 origin for the agent's HTTP lookup tool (AssemblyAI calls this):
# PATIENT_RECORDS_API_URL=http://127.0.0.1:8000/api/v1
# PATIENT_RECORDS_API_KEY=service-demo-token

# Role 2 structured-case extraction (turns the transcript into every schema
# field). Without a key, the deterministic regex fallback in
# src/extraction/demo_adapter.py is used instead (limited field coverage).
# Cheapest good option: OpenRouter + DeepSeek.
# OPENROUTER_API_KEY=
# ARIA_EXTRACTION_OPENAI_MODEL=deepseek/deepseek-chat
# Or use OpenAI directly instead:
# OPENAI_API_KEY=
# ARIA_EXTRACTION_OPENAI_MODEL=gpt-4o-mini
# Force a provider regardless of which keys are set (openai|demo):
# ARIA_EXTRACTION_PROVIDER=
